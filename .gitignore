!apps/api/src/database/seeds/*.js
apps/api/src/**/*.d.ts
apps/api/test/**/*.js
apps/api/test/**/*.d.ts
apps/mobile/app/**/*.js
apps/mobile/app/**/*.d.ts
apps/mobile/src/**/*.js
apps/mobile/src/**/*.d.ts
packages/*/src/**/*.js
packages/*/src/**/*.d.ts

# ── Turbo cache ───────────────────────────────────────────
.turbo/

# ── Environment & Secrets ─────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
*.key
*.pem
jwt-private.key
jwt-public.key
*-private.key
*-public.key

