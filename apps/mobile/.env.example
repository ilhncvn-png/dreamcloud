# ── App Environment ─────────────────────────────────────
APP_ENV=development

# ── API ─────────────────────────────────────────────────
# Staging / production:
# EXPO_PUBLIC_API_URL=https://dreamcloud-production.up.railway.app/api/v1
# Local development:
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# ── Expo ────────────────────────────────────────────────
EXPO_PUBLIC_EAS_PROJECT_ID=REPLACE_WITH_EAS_PROJECT_ID
