# ── Application ─────────────────────────────────────────
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── Database (read-only user for NLP queries) ────────────
DATABASE_URL=postgresql+asyncpg://dreamcloud_nlp_ro:REPLACE_WITH_PASS@localhost:5432/dreamcloud_dev
DATABASE_POOL_SIZE=5

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=dreamcloud:nlp:

# ── NLP Model ───────────────────────────────────────────
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MODEL_CACHE_DIR=./models
VECTOR_DIMENSION=384
MATCH_SIMILARITY_THRESHOLD=0.65
MATCH_LIMIT=20

# ── Internal Auth (shared secret with NestJS API) ───────
INTERNAL_API_KEY=dev-internal-key-change-in-production

# ── Celery ──────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
