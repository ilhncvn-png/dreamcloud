{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "@dreamcloud/shared-types": "<rootDir>/../packages/shared-types/src",
    "@dreamcloud/utils": "<rootDir>/../packages/utils/src"
  }
}
