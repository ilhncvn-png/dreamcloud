# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,exp://localhost:8081

# ── Database (PostgreSQL + pgvector) ───────────────────────────
DATABASE_URL=postgresql://dreamcloud:dreamcloud_dev_pass@localhost:5432/dreamcloud_dev
DATABASE_POOL_SIZE=10

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=dreamcloud:

# ── JWT RS256 ─────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.key
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.key
JWT_ACCESS_TOKEN_TTL=900          # 15 minutes (seconds)
JWT_REFRESH_TOKEN_TTL=2592000     # 30 days (seconds)

# ── AWS ───────────────────────────────────────────────────────
AWS_REGION=eu-central-1
AWS_S3_BUCKET_MEDIA=dreamcloud-media-dev
AWS_SES_FROM_EMAIL=noreply@dreamcloud.app
AWS_SECRETS_MANAGER_PREFIX=dreamcloud/dev

# ── NLP Service ───────────────────────────────────────────────
NLP_SERVICE_URL=http://localhost:8000
NLP_SERVICE_TIMEOUT_MS=5000

# ── Bull Queue ────────────────────────────────────────────────
BULL_QUEUE_PREFIX=dreamcloud:queue

# ── Rate Limiting ─────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=900000      # 15 minutes
AUTH_THROTTLE_LIMIT=10

# ── Moderation ────────────────────────────────────────────────
OPENAI_API_KEY=
MODERATION_ENABLED=false         # Enable in staging/production
